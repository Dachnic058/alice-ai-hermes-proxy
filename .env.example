# ===== Обязательно =====
FOLDER_ID=your-folder-id

# ===== Режим 1: готовый IAM-токен (тест / быстрый старт) =====
# IAM-токен живёт ~12 ч (пользовательский) / ~1 ч (сервисный). Прокси НЕ обновляет его сам.
IAM_TOKEN=

# ===== Режим 2: ключ сервисного аккаунта (продакшн, автообновление) =====
# Положи authorized_key.json рядом и укажи путь, ИЛИ вставь JSON целиком.
SA_JSON_PATH=./authorized_key.json
# SA_JSON={"id":"...","service_account_id":"...","created_at":"...","key_algorithm":"RSA_2048","public_key":"...","private_key":"..."}

# Как часто обменивать JWT на свежий IAM-токен (минуты, по умолчанию 55)
TOKEN_REFRESH_INTERVAL_MIN=55

# ===== Опционально =====
PORT=3000
HOST=127.0.0.1
# Модели, которые видит Hermes (через запятую). YandexGPT API поддерживает OpenAI-совместимый формат.
PROXY_MODELS=yandexgpt/latest,yandexgpt-lite/latest,alice-ai/latest
# Если Яндекс поменяет базовый URL:
# YC_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
